# --- Database (Neon or any PostgreSQL). ---
# Use the "direct" string on your computer (for `npm run db:push`) and the POOLED one (host contains -pooler) on Vercel.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Security: any long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

PORT=4000
# Optional: how many database connections each server instance may hold (default 10, or 3 on Vercel).
# DB_POOL_MAX=3
# Where the web app is hosted (comma separated). Leave empty to allow any origin while developing.
CORS_ORIGIN="http://localhost:5173"
# Flutterwave sends the customer back here after paying. No trailing slash.
WEB_URL="http://localhost:5173"

# --- What one subscription period costs (whole number), and how long a period is: yearly or monthly ---
ORG_PRICE=120000
ORG_CURRENCY=NGN
BILLING_INTERVAL=yearly

# --- Flutterwave (v3 API keys, from Settings > API in your Flutterwave dashboard) ---
FLW_SECRET_KEY=""
# A secret you invent and ALSO paste into Flutterwave's webhook settings ("Secret hash").
FLW_SECRET_HASH=""
# The recurring plan that makes automatic renewal work. Create it once with `npm run create-plan`
# (or in the Flutterwave dashboard: same amount, interval and currency as above) and paste its id here.
# Leave empty to sell one period at a time with no automatic renewal.
FLW_PLAN_ID=""

# --- Your own platform-admin login, created once by `npm run seed` ---
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
